table Sales

	column OrderID
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: OrderID

	column OrderDate
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: OrderDate

	column CustomerID
		dataType: string
		summarizeBy: none
		sourceColumn: CustomerID

	column ProductID
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: ProductID

	column UnitPrice
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: UnitPrice

	column Quantity
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Quantity

	column Discount
		dataType: double
		formatString: 0%
		summarizeBy: none
		sourceColumn: Discount

	measure 'Total Revenue' = SUMX(Sales, Sales[UnitPrice] * Sales[Quantity] * (1 - Sales[Discount]))
		formatString: #,0

	measure Orders = DISTINCTCOUNT(Sales[OrderID])
		formatString: #,0

	measure 'Units Sold' = SUM(Sales[Quantity])
		formatString: #,0

	measure 'Avg Order Value' = DIVIDE([Total Revenue], [Orders])
		formatString: #,0.00

	measure 'Revenue Prior Year' = CALCULATE([Total Revenue], SAMEPERIODLASTYEAR('Calendar'[Date]))
		formatString: #,0

	measure 'Revenue YoY %' = DIVIDE([Total Revenue] - [Revenue Prior Year], [Revenue Prior Year])
		formatString: 0.0%

	measure 'Avg Discount %' = DIVIDE(SUMX(Sales, Sales[UnitPrice] * Sales[Quantity] * Sales[Discount]), SUMX(Sales, Sales[UnitPrice] * Sales[Quantity]))
		formatString: 0.0%

	partition Sales = m
		mode: import
		source =
			let
			    Src = OData.Feed("https://services.odata.org/V4/Northwind/Northwind.svc/", null, [Implementation="2.0"]),
			    OD = Table.SelectColumns(Src{[Name="Order_Details", Signature="table"]}[Data], {"OrderID","ProductID","UnitPrice","Quantity","Discount"}),
			    Ord = Table.SelectColumns(Src{[Name="Orders", Signature="table"]}[Data], {"OrderID","OrderDate","CustomerID"}),
			    Joined = Table.NestedJoin(OD, {"OrderID"}, Ord, {"OrderID"}, "O", JoinKind.Inner),
			    Expanded = Table.ExpandTableColumn(Joined, "O", {"OrderDate","CustomerID"}),
			    Ordered = Table.SelectColumns(Expanded, {"OrderID","OrderDate","CustomerID","ProductID","UnitPrice","Quantity","Discount"}),
			    Typed = Table.TransformColumnTypes(Ordered, {{"OrderID", Int64.Type}, {"OrderDate", type date}, {"CustomerID", type text}, {"ProductID", Int64.Type}, {"UnitPrice", type number}, {"Quantity", Int64.Type}, {"Discount", type number}}, "en-US")
			in
			    Typed
