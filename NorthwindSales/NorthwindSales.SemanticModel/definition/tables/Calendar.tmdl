table Calendar

	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Long Date
		summarizeBy: none
		sourceColumn: [Date]

	column Year = YEAR('Calendar'[Date])
		dataType: int64
		formatString: 0
		summarizeBy: none

	column 'Month Number' = MONTH('Calendar'[Date])
		dataType: int64
		formatString: 0
		summarizeBy: none

	column 'Year Month' = FORMAT('Calendar'[Date], "yyyy-MM")
		dataType: string
		summarizeBy: none

	partition Calendar = calculated
		mode: import
		source = CALENDAR(DATE(YEAR(MIN(Sales[OrderDate])), 1, 1), DATE(YEAR(MAX(Sales[OrderDate])), 12, 31))
